# 构建产物
dist/
release/

# 端到端测试的临时截图（docs/screenshots 是正式发布截图，需入库）
screenshots/*.png
!screenshots/.gitkeep
!screenshots/browser-report.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# 依赖（本项目零依赖，但防止误提交）
node_modules/

# 临时文件
.parity-payload.json
.parity-node.mjs
__pycache__/
*.pyc

# 构建产物（由 tools/build.mjs 从 cases/public 与 engine/ 复制生成，不入库）
site/cases/
site/engine/

# 审计过程截图（270 张 / 87 MB）：可由 work/qa/ 下保留的脚本重新生成，
# 报告与原始 JSON 已入库，截图不入库以免仓库膨胀。
work/qa/**/*.png
work/qa/**/shots/
work/qa/**/crops/
work/qa/**/raw/live-*.mjs
work/qa/**/raw/live-*.css
work/qa/**/raw/live-end/
